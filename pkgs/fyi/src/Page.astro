---
import { parseDoc, type ParserOptions } from "./parser/index.ts";
import { renderDoc, type DisplayOptions } from "./renderer/index.ts";
import Hero from "./components/Hero.astro";
import Links, { type Link } from "./components/Links.astro";
import Doc from "./components/Doc.astro";
import Footer from "./components/Footer.astro";
import Installation from "./components/Installation.astro";
import "./styles.css";

type Props = PageProps;

export interface PageProps extends ParserOptions, DisplayOptions {
  title?: string;
  description?: string;
  lang?: string;
  favicon?: string;
  links?: Link[];
  markdown: string;
}

const {
  title: titleProp,
  description,
  lang = "en",
  favicon,
  links = [],
  markdown,
  parseHero,
  parseLicense,
  parseInstallation,
  displayLicenseInFooter,
} = Astro.props;

const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);

const parsed = await parseDoc(markdown, { parseHero, parseLicense, parseInstallation });
const doc = await renderDoc(parsed, { displayLicenseInFooter });
const footerSections = displayLicenseInFooter
  ? doc.sections.filter((section) => section.kind === "license")
  : [];
const mainSections = doc.sections.filter((section) => !displayLicenseInFooter || section.kind !== "license");
const hasHero = doc.sections.some((section) => section.kind === "hero");

const title = titleProp ?? doc.title ?? "Documentation";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {
      Astro.slots.has("favicon") ? (
        <slot name="favicon" />
      ) : (
        favicon && <link rel="icon" href={favicon} />
      )
    }
    <slot name="head" />
  </head>
  <body class="fyi-body">
    <div class="fyi-page">
      {!hasHero && <Links links={links} />}

      <main>
        {
          mainSections.map((section) =>
            section.kind === "hero" ? (
              <>
                <Hero section={section} />
                <Links links={links} />
              </>
            ) : section.kind === "installation" ? (
              <Installation section={section} />
            ) : (
              <Doc section={section} />
            ),
          )
        }
      </main>

      {
        (footerSections.length > 0 || Astro.slots.has("footer")) && (
          <Footer>
            {footerSections.map((section) => <Doc section={section} />)}
            <slot name="footer" />
          </Footer>
        )
      }
    </div>
  </body>
</html>
