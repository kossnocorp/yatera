---
import { renderDoc } from "./renderer/index.ts";
import GitHubIcon from "../vendor/@http/cdn.jsdelivr.net/gh/devicons/devicon@latest/icons/github/github-original.svg";
import "./styles.css";

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  favicon?: string;
  links?: { label: string; href: string; icon?: "github" }[];
  markdown: string;
}

const {
  title: titleProp,
  description,
  lang = "en",
  favicon,
  links = [],
  markdown,
} = Astro.props;

const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site);

const doc = await renderDoc(markdown);

const title = titleProp ?? doc.title ?? "Documentation";
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {favicon && <link rel="icon" href={favicon} />}
    <slot name="head" />
  </head>
  <body class="fyi-body">
    <div class="fyi-page">
      {
        links.length > 0 && (
          <nav class="fyi-links" aria-label="Project links">
            <ul>
              {links.map(({ label, href, icon }) => (
                <li>
                  <a href={href}>
                    {icon === "github" && (
                      <GitHubIcon class="fyi-icon" aria-hidden="true" />
                    )}
                    {label}
                  </a>
                </li>
              ))}
            </ul>
          </nav>
        )
      }

      <main class="fyi-doc" set:html={doc.html} />

      {
        Astro.slots.has("footer") && (
          <footer>
            <slot name="footer" />
          </footer>
        )
      }
    </div>
  </body>
</html>
