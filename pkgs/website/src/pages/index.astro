---
import Page, { type PageProps } from "fyi.party/Page.astro";
import readme from "../../../crate/README.md?raw";

export interface Hello extends PageProps {
  hi: true;
}

export const prerender = true;
---

<Page
  title="Yatera - Yet Another Tera CLI"
  description="Tera template rendering CLI"
  favicon="/favicon.svg"
  links={[
    {
      label: "Playground",
      href: "/playground",
    },
    {
      label: "GitHub",
      href: "https://github.com/kossnocorp/yatera",
      icon: "github",
    },
  ]}
  markdown={readme}
  parseHero
  parseLicense
  parseInstallation
  displayLicenseInFooter
/>
