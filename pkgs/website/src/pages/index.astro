---
import Layout from "#/ui/layouts/Layout.astro";
import GitHubIcon from "#/assets/github-original.svg";
import Code from "astro/components/Code.astro";
import { lit } from "smollit";
---

<Layout
  title="Yatera - Yet Another Tera CLI"
  description="Tera template rendering CLI"
>
  <div class="page">
    <main class="landing">
      <section class="section hero">
        <header class="heading">
          <h1>Yatera</h1>

          <p class="subheadline">Yet Another Tera CLI</p>
        </header>

        <p class="description">
          It supports Tera v2, and features <a href="#usage">rich DX</a> and
          <a href="#builtins">extra built-ins</a>.
        </p>

        <Code
          code={lit`
            # Render a template with variables:
            cat template.tera | tera var1=value var2=value > output.txt

            # Use structured data as variables (JSON/TOML/YAML):
            cat template.tera | tera --json '{"var":"value"}' > output.txt
            cat template.tera | tera --json-file vars.json > output.txt

            # Read and write files directly:
            tera --from template.tera --to output.txt --json-file vars.json
          `}
          lang="bash"
          theme="css-variables"
        />

        <nav class="links">
          <ul>
            <li>
              <a href="https://github.com/kossnocorp/yatera" class="link">
                <GitHubIcon class="icon" />GitHub
              </a>
            </li>
          </ul>
        </nav>
      </section>

      <section class="section install">
        <h2>Install yatera</h2>

        <ul>
          <li>
            <span class="label">macOS/Linux:</span>
            <pre><code>curl -fsSL https://yatera.fyi/install.sh | sh</code></pre>
          </li>
          <li>
            <span class="label">Windows:</span>
            <pre><code>irm https://yatera.fyi/install.ps1 | iex</code></pre>
          </li>
          <li>
            <span class="label">Cargo Binstall:</span>
            <pre><code>cargo binstall yatera</code></pre>
          </li>
        </ul>
      </section>

      <section class="section usage">
        <h2 id="usage">Usage</h2>

        <p>
          Use the <code>tera</code> command to render templates from stdin. Environment
          sources parse the variable's contents as JSON, TOML, or YAML. Choose one
          structured context source; <code>name=value</code>
          arguments override its values. Missing variables or invalid context contents
          produce an error.
        </p>

        <h3 id="input">Input</h3>

        <p>
          By default Yatera reads the template from stdin. You can override this
          behavior by using the <code>--from</code> option to specify a template file:
        </p>

        <Code
          code="tera --from template.tera > output.txt"
          lang="bash"
          theme="css-variables"
        />

        <h3 id="output">Output</h3>

        <p>
          By default Yatera writes the rendered result to stdout. You can
          override this behavior by using the <code>--to</code> option to specify
          an output file:
        </p>

        <Code
          code="tera --from template.tera --to output.txt"
          lang="bash"
          theme="css-variables"
        />

        <h3 id="variables">Variables</h3>

        <p>
          Yatera supports multiple ways to provide template variables, from
          passing arguments to JSON/TOML/YAML strings or files.
        </p>

        <h4 id="arguments">Argument Variables</h4>

        <p>
          To provide template variables directly as command-line arguments, use
          the <code>name=value</code> format:
        </p>

        <Code
          code="cat template.tera | tera var1=value var2=value > output.txt"
          lang="bash"
          theme="css-variables"
        />

        <h4 id="variable-files">Variable Files</h4>

        <p>To read variables from JSON/TOML/YAML files:</p>

        <Code
          code="cat template.tera | tera --json-file vars.json > output.txt"
          lang="bash"
          theme="css-variables"
        />

        <p><strong>CLI options</strong>:</p>

        <table>
          <thead>
            <tr>
              <th>Argument</th>
              <th>Format</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>--json-file vars.json</code></td>
              <td>JSON</td>
            </tr>
            <tr>
              <td><code>--toml-file vars.toml</code></td>
              <td>TOML</td>
            </tr>
            <tr>
              <td><code>--yaml-file vars.yaml</code></td>
              <td>YAML</td>
            </tr>
          </tbody>
        </table>

        <h4 id="variable-strings">Variable Strings</h4>

        <p>To read variables from JSON/TOML/YAML strings:</p>

        <Code
          code={lit`
            cat template.tera | tera --json '{"var":"value"}' > output.txt
          `}
          lang="bash"
          theme="css-variables"
        />

        <p><strong>CLI options</strong>:</p>

        <table>
          <thead>
            <tr>
              <th>Argument</th>
              <th>Format</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>{`--json '{"var":"value"}'`}</code></td>
              <td>JSON</td>
            </tr>
            <tr>
              <td><code>--toml "$(cat vars.toml)"</code></td>
              <td>TOML</td>
            </tr>
            <tr>
              <td><code>--yaml "$(cat vars.yaml)"</code></td>
              <td>YAML</td>
            </tr>
          </tbody>
        </table>

        <h5 id="environment-variable-strings">Environment Variable Strings</h5>

        <p>
          Yatera also supports reading variables from JSON/TOML/YAML strings
          stored in environment variables:
        </p>

        <Code
          code={lit`
            export VARS='{"var":"value"}'
            cat template.tera | tera --json-env VARS
          `}
          lang="bash"
          theme="css-variables"
        />

        <p><strong>CLI options</strong>:</p>

        <table>
          <thead>
            <tr>
              <th>Argument</th>
              <th>Format</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td><code>--json-env VARS</code></td>
              <td>JSON</td>
            </tr>
            <tr>
              <td><code>--toml-env VARS</code></td>
              <td>TOML</td>
            </tr>
            <tr>
              <td><code>--yaml-env VARS</code></td>
              <td>YAML</td>
            </tr>
          </tbody>
        </table>
      </section>

      <section class="section builtins">
        <h2 id="builtins">Built-Ins</h2>

        <p>
          Yatera supports all default <a
            href="https://keats.github.io/tera/#built-ins"
            class="link">Tera built-ins</a
          > as well as extra filters.
        </p>

        <h3 id="extra-filters">Extra Filters</h3>

        <h4 id="heck">heck</h4>

        <p>
          <a href="https://crates.io/crates/heck" class="link">heck</a> methods are
          available as string filters:
        </p>

        <Code
          code={lit`
            printf '{{ name | to_snake_case }}' | tera name="Hello World"
            #=> hello_world
          `}
          lang="bash"
          theme="css-variables"
        />

        <table>
          <thead>
            <tr>
              <th>Filter</th>
              <th>Result for <code>Hello World</code></th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <td>
                <code>to_upper_camel_case</code> / <code>to_pascal_case</code>
              </td>
              <td><code>HelloWorld</code></td>
            </tr>
            <tr>
              <td><code>to_lower_camel_case</code></td>
              <td><code>helloWorld</code></td>
            </tr>
            <tr>
              <td><code>to_snake_case</code></td>
              <td><code>hello_world</code></td>
            </tr>
            <tr>
              <td><code>to_kebab_case</code></td>
              <td><code>hello-world</code></td>
            </tr>
            <tr>
              <td><code>to_shouty_snake_case</code></td>
              <td><code>HELLO_WORLD</code></td>
            </tr>
            <tr>
              <td><code>to_shouty_kebab_case</code></td>
              <td><code>HELLO-WORLD</code></td>
            </tr>
            <tr>
              <td><code>to_title_case</code></td>
              <td><code>Hello World</code></td>
            </tr>
            <tr>
              <td><code>to_train_case</code></td>
              <td><code>Hello-World</code></td>
            </tr>
          </tbody>
        </table>
      </section>
    </main>

    <footer>
      Sasha Koss © 2026 <a href="https://koss.nocorp.me/mit" class="link"
        >MIT License</a
      >
    </footer>
  </div>
</Layout>

<style>
  @reference "#/ui/styles/global.css";

  .page {
    @apply w-full max-w-5xl mx-auto px-6 py-12 sm:px-12 sm:py-20 flex flex-col gap-20;
  }

  .landing {
    @apply flex flex-col gap-12;
  }

  .section {
    @apply flex flex-col gap-4;
  }

  h1 {
    @apply text-5xl sm:text-7xl font-bold text-(--color-heading-1);
  }

  h2 {
    @apply text-xl font-bold text-(--color-heading-2);
  }

  h3,
  h4,
  h5 {
    @apply text-base font-bold text-(--color-heading-3);
  }

  .hero {
    & .heading {
      @apply flex flex-col gap-2;

      & .subheadline {
        @apply text-xl font-semibold text-(--color-heading-2);
      }
    }

    & .description,
    & .links {
      @apply text-balance max-w-xl;
    }

    & .description {
      @apply text-(--color-text) text-lg;
    }
  }

  .install {
    & ul {
      @apply flex flex-col gap-4;

      & li {
        @apply flex flex-col gap-2;
      }

      & .label {
        @apply font-semibold text-(--color-heading-2);
      }

      & pre {
        @apply border border-(--color-code-border) rounded-md px-2 py-1 w-full max-w-md overflow-x-auto font-mono bg-(--color-code-canvas) text-(--color-code-ink) text-sm;
      }
    }
  }

  table {
    @apply table-auto border-collapse;

    & th {
      @apply bg-(--color-table-header-canvas) font-bold text-left;
    }

    & th,
    & td {
      @apply border border-(--color-table-border) px-4 py-2;
    }
  }

  footer {
    @apply opacity-70 hover:opacity-100;
  }
</style>
